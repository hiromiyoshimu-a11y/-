# ----------------------------------------------------
# PubMed Catheter Ablation Workflow Environment Config
# ----------------------------------------------------

# Google Gemini API キー (高精度な日本語3〜4行要約に必要)
# 未設定の場合は無料の翻訳・抽出フォールバックロジックで動作します。
GEMINI_API_KEY=

# 過去何日分の論文を取得するか (デフォルト: 90日 = 過去3ヶ月)
DAYS_PAST=90

# 取得件数上限 (デフォルト: 50件)
MAX_RESULTS=50

# ----------------------------------------------------
# メール通知設定 (オプション: 設定した場合、生成したExcelを添付送信)
# ----------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# NOTIFICATION_EMAIL=destination_email@example.com
